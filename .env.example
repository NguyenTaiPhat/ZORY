# ========================================================
# ZORY PLATFORM - CẤU HÌNH MÔI TRƯỜNG
# ========================================================

# Cơ sở dữ liệu: Mặc định SQLite file:./dev.db cho local, hoặc PostgreSQL
DATABASE_URL="file:./dev.db"

# Bảo mật xác thực
AUTH_SECRET="zory-super-secret-jwt-key-minimum-32-chars-long-2025"
APP_URL="http://localhost:3000"

# AI Provider Adapter (mock | gemini | openai | groq)
AI_PROVIDER="mock"
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL="gemini-3.8-flash"

# TTS Provider Adapter (web-speech | edge | google | azure | mock)
TTS_PROVIDER="web-speech"
TTS_API_KEY=""
TTS_REGION=""
TTS_VOICE="vi-VN-HoaiMyNeural"

# Quota mặc định (ký tự AI / tháng, ký tự TTS / tháng)
DEFAULT_AI_TOKEN_QUOTA="50000"
DEFAULT_TTS_CHAR_QUOTA="30000"
